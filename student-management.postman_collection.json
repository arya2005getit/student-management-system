{
  "info": {
    "_postman_id": "89b38edf-64ae-40e2-a343-0f6c521dc990",
    "name": "Student Management API",
    "description": "CRUD requests for the Student Management API. Run Create Student first; its test saves studentId for the following requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "studentId", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": { "method": "GET", "url": "{{baseUrl} }/api/health" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('API is running', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "Create Student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Maya Patel\",\n  \"email\": \"maya.patel@example.com\",\n  \"course\": \"Computer Science\",\n  \"year\": 2\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/students"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student created', function () { pm.response.to.have.status(201); });", "const student = pm.response.json();", "pm.collectionVariables.set('studentId', student._id);"] } }]
    },
    {
      "name": "Get All Students",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/students" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student list returned', function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an('array'); });"] } }]
    },
    {
      "name": "Get Student by ID",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/students/{{studentId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student details returned', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "Update Student (PUT)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Maya Patel\",\n  \"email\": \"maya.patel@example.com\",\n  \"course\": \"Information Technology\",\n  \"year\": 3\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student updated', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "Partially Update Student (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"course\": \"Computer Science\"\n}", "options": { "raw": { "language": "json" } } },
        "url": "{{baseUrl}}/api/students/{{studentId}}"
      },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student partially updated', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "Delete Student",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/students/{{studentId}}" },
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student deleted', function () { pm.response.to.have.status(200); });"] } }]
    }
  ]
}
